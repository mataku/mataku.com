{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": [
    "* 15 1 * *"
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions", "npm"],
      "groupName": "devDependencies"
    }
  ]
}
