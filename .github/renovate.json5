{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>mataku/renovate-config:default.json5"
  ],
  "schedule": [
    "* 15-23 * * 5"
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "matchManagers": ["gradle-wrapper"],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "matchManagers": ["gradle", "npm"],
      "groupName": "dependencies",
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "matchManagers": ["gradle"],
      "matchPackageNames": ["/^org\\.jetbrains\\.kotlin[.:]/"],
      "groupName": "kotlin",
      // Also track Beta / RC releases (stable releases remain tracked)
      "ignoreUnstable": false,
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "matchDatasources": ["java-version"],
      "minimumReleaseAge": null,
      "allowedVersions": "/\\.LTS$/"
    }
  ]
}
